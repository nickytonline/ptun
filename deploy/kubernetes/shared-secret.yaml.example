# Placeholder only. Pomerium Core's shared_secret (base64), the config API token: full admin over Pomerium.
# Don't commit a real value. Create the Secret out of band instead, for example:
#   kubectl -n <ns> create secret generic tunnel-broker --from-literal=SHARED_SECRET="$SHARED_SECRET"
# The .example suffix keeps `kubectl apply -f deploy/kubernetes/` from applying it over that real Secret.
# To use it instead, copy it to a .yaml file outside this directory, replace the value, and apply that.
apiVersion: v1
kind: Secret
metadata:
  name: tunnel-broker
  labels: {app.kubernetes.io/name: tunnel-broker}
type: Opaque
stringData:
  SHARED_SECRET: REPLACE-WITH-POMERIUM-SHARED-SECRET
